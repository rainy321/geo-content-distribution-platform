# Copy this file to app.env on the server and set permissions to 0600.
# Never commit app.env or paste its contents into logs.

SERVER_THREADS=8
SERVER_CHANNEL_TIMEOUT_SECONDS=180

AI_BASE_URL=https://example.com/compatible-mode/v1
AI_API_KEY=replace-with-server-secret
AI_MODEL=replace-with-model-name

# Keep qwen during deploys and rollbacks. Change to colleague only after the
# profile-gated service is ready from inside the Compose network.
CONTENT_ENGINE=qwen
CONTENT_ENGINE_FALLBACK=
COLLEAGUE_CONTENT_ENGINE_URL=http://content-engine:8080
COLLEAGUE_CONTENT_ENGINE_ALLOWED_HOSTS=content-engine
COLLEAGUE_CONNECT_TIMEOUT_SECONDS=3
COLLEAGUE_READ_TIMEOUT_SECONDS=120
COLLEAGUE_MAX_RESPONSE_BYTES=2097152
# Required for a production colleague service; use a separate random value and
# configure the matching verifier name in content-engine.env.
COLLEAGUE_CONTENT_ENGINE_TOKEN=replace-with-a-separate-internal-token

APP_ACCESS_PASSWORD=replace-with-a-long-operator-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_SESSION_HOURS=12
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
AI_RATE_LIMIT_PER_MINUTE=6
CORS_ALLOWED_ORIGINS=https://geo.example.com
SESSION_COOKIE_SECURE=true

DEMO_MODE=false
SEED_DEMO_DATA=false
# Two-day commercial gate: keep false. In particular, the Bilibili runtime is
# not approved until its version/hash, safe extraction and license are closed.
ALLOW_REAL_PUBLISHING=false
# Independent code-level gate; keep false even if other platforms are enabled.
ENABLE_BILIBILI_RUNTIME=false
PUBLISH_SCHEDULER_INTERVAL_SECONDS=15
DEBUG_MODE=false

# Optional shared limiter. A single-server deployment can leave both blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

