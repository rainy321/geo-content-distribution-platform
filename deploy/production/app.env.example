# Copy this file to app.env on the server and set permissions to 0600.
# Never commit app.env or paste its contents into logs.

AI_BASE_URL=https://example.com/compatible-mode/v1
AI_API_KEY=replace-with-server-secret
AI_MODEL=replace-with-model-name

APP_ACCESS_PASSWORD=replace-with-a-long-operator-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_SESSION_HOURS=12
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
AI_RATE_LIMIT_PER_MINUTE=6
CORS_ALLOWED_ORIGINS=https://geo.example.com
SESSION_COOKIE_SECURE=true

DEMO_MODE=false
SEED_DEMO_DATA=false
ALLOW_REAL_PUBLISHING=false
PUBLISH_SCHEDULER_INTERVAL_SECONDS=15
DEBUG_MODE=false

# Optional shared limiter. A single-server deployment can leave both blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

