# Reference only: the application does not auto-load this file.
# Export these variables in the shell or deployment environment.

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional model price catalog used to snapshot estimated cost per call. Keys
# are provider/model (with */model, provider/* and */* fallbacks); prices are
# per 1,000,000 tokens. Leave blank rather than entering guessed or stale fees.
# Example: {"qwen/qwen-plus":{"input_per_million":"...","output_per_million":"...","currency":"CNY"}}
AI_PRICE_CATALOG_JSON=

# Content-engine routing. Qwen remains the safe default. Set CONTENT_ENGINE to
# colleague only after the internal service passes both health endpoints.
CONTENT_ENGINE=qwen
CONTENT_ENGINE_FALLBACK=
COLLEAGUE_CONTENT_ENGINE_URL=http://content-engine:8080
COLLEAGUE_CONTENT_ENGINE_ALLOWED_HOSTS=content-engine
COLLEAGUE_CONNECT_TIMEOUT_SECONDS=3
COLLEAGUE_READ_TIMEOUT_SECONDS=120
COLLEAGUE_MAX_RESPONSE_BYTES=2097152
COLLEAGUE_CONTENT_ENGINE_TOKEN=

# Optional production hardening. Configure both secrets together to enable the
# operator access gate; never commit their real values.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_HOURS=12
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
AI_RATE_LIMIT_PER_MINUTE=6
# Public-site audit performs bounded GET requests only after operator confirmation.
SITE_AUDIT_RATE_LIMIT_PER_MINUTE=3
# Fail-closed by default. Enable only when this machine deliberately uses a
# Clash-style 198.18.0.0/15 Fake-IP DNS/TUN mode; connections stay IP-pinned.
SITE_AUDIT_ALLOW_PROXY_FAKE_IP=false
# Optional shared cross-instance limiter. Leave both empty for the built-in
# per-instance fallback; configure both together after creating Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false

LOCAL_CHROME_PATH=
LOCAL_CHROME_HEADLESS=true
DEBUG_MODE=false
XHS_SERVER=http://127.0.0.1:11901

DEMO_MODE=true
SEED_DEMO_DATA=true
ALLOW_REAL_PUBLISHING=false
# Unattended real publishing remains disabled until two-phase authorization exists.
SCHEDULED_REAL_PUBLISHING_ENABLED=false
# Independent fail-closed gate for the unpinned Bilibili executable runtime.
ENABLE_BILIBILI_RUNTIME=false
DATABASE_PATH=db/database.db
COOKIES_DIRECTORY=cookiesFile
MEDIA_ROOT=videoFile
PUBLISH_SCHEDULER_INTERVAL_SECONDS=15
RUN_PUBLISH_SCHEDULER=true
SERVER_HOST=127.0.0.1
SERVER_PORT=5409
SERVER_THREADS=8
SERVER_CHANNEL_TIMEOUT_SECONDS=180
