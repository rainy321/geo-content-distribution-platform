# Reference only: the application does not auto-load this file.
# Export these variables in the shell or deployment environment.

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional production hardening. Configure both secrets together to enable the
# operator access gate; never commit their real values.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_HOURS=12
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
AI_RATE_LIMIT_PER_MINUTE=6
# Optional shared cross-instance limiter. Leave both empty for the built-in
# per-instance fallback; configure both together after creating Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false

LOCAL_CHROME_PATH=
LOCAL_CHROME_HEADLESS=true
DEBUG_MODE=false
XHS_SERVER=http://127.0.0.1:11901

DEMO_MODE=true
SEED_DEMO_DATA=true
ALLOW_REAL_PUBLISHING=false
DATABASE_PATH=db/database.db
COOKIES_DIRECTORY=cookiesFile
MEDIA_ROOT=videoFile
PUBLISH_SCHEDULER_INTERVAL_SECONDS=15
RUN_PUBLISH_SCHEDULER=true
SERVER_HOST=127.0.0.1
SERVER_PORT=5409
